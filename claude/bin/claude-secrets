#!/usr/bin/env bash
# Carries machine-local secrets between machines as one passphrase-encrypted file.
#   claude-secrets export <file>   on the machine that has them
#   claude-secrets import <file>   on the new machine (after claude-bootstrap has cloned the repos)
# What travels is listed in ~/.config/claude/secrets.list and ~/.claude/company/*/secrets.list.
set -euo pipefail

usage() { echo "usage: claude-secrets export|import <file>" >&2; exit 2; }
# The passphrase is prompted for, or read from CLAUDE_SECRETS_PASS when set (unattended runs).
pass=()
[ -n "${CLAUDE_SECRETS_PASS:-}" ] && pass=(-pass env:CLAUDE_SECRETS_PASS)
[ $# -eq 2 ] || usage

lists=("$HOME/.config/claude/secrets.list")
for f in "$HOME"/.claude/company/*/secrets.list; do
  [ -f "$f" ] && lists+=("$f")
done

entries() {
  sed -e 's/#.*//' -e 's/[[:space:]]*$//' "${lists[@]}" | grep -v '^$' || true
}

export_bundle() {
  local out=$1 pattern p
  work=$(mktemp -d)
  trap 'rm -rf "$work"' EXIT
  mkdir -p "$work/files"
  cd "$HOME"
  while read -r pattern; do
    if [ "$pattern" = "@mcp" ]; then
      python3 -I -c '
import json, os, sys
d = json.load(open(os.path.expanduser("~/.claude.json")))
json.dump(d.get("mcpServers", {}), open(sys.argv[1], "w"), indent=2)' "$work/mcp-servers.json"
      continue
    fi
    # Unquoted on purpose: the pattern may be a glob relative to $HOME.
    for p in $pattern; do
      if [ ! -f "$p" ]; then
        echo "missing: ~/$p" >&2
        continue
      fi
      mkdir -p "$work/files/$(dirname "$p")"
      cp -p "$p" "$work/files/$p"
    done
  done < <(entries)
  tar -C "$work" -czf - . | openssl enc -aes-256-cbc -pbkdf2 -salt ${pass[@]+"${pass[@]}"} -out "$out"
  chmod 600 "$out"
  echo "wrote $out"
}

import_bundle() {
  local in=$1 p dest name json
  work=$(mktemp -d)
  trap 'rm -rf "$work"' EXIT
  openssl enc -d -aes-256-cbc -pbkdf2 ${pass[@]+"${pass[@]}"} -in "$in" | tar -xzf - -C "$work"
  if [ -d "$work/files" ]; then
    while read -r p; do
      p=${p#./}
      dest="$HOME/$p"
      if [ -e "$dest" ] && ! cmp -s "$work/files/$p" "$dest"; then
        cp -p "$dest" "$dest.before-import"
        echo "kept the old copy as ~/$p.before-import"
      fi
      mkdir -p "$(dirname "$dest")"
      cp -p "$work/files/$p" "$dest"
      chmod 600 "$dest"
      echo "file: ~/$p"
    done < <(cd "$work/files" && find . -type f)
  fi
  if [ -f "$work/mcp-servers.json" ]; then
    while IFS=$'\t' read -r name json; do
      claude mcp remove -s user "$name" >/dev/null 2>&1 || true
      claude mcp add-json -s user "$name" "$json" >/dev/null
      echo "mcp: $name"
    done < <(python3 -I - "$work/mcp-servers.json" <<'EOF'
import json, platform, sys
for name, cfg in json.load(open(sys.argv[1])).items():
    if platform.system() != "Darwin" and cfg.get("command", "").startswith("/Applications/"):
        print(f"skip: mcp {name} runs a macOS app", file=sys.stderr)
        continue
    print(name + "\t" + json.dumps(cfg))
EOF
)
  fi
}

case "$1" in
  export) export_bundle "$2" ;;
  import) import_bundle "$2" ;;
  *) usage ;;
esac
