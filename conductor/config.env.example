# =============================================================================
# Conductor Configuration (machine-local, DO NOT commit)
# Copy this to config.env and fill in your values:
#   cp config.env.example config.env
# =============================================================================

# --- Project ---
# Absolute path to the project root
PROJECT_DIR=""

# Where worktrees are created (defaults to ~/worktrees/<project-name>)
# WORKTREES_BASE="$HOME/worktrees/myproject"

# --- Git ---
# Base branch to create worktrees from (e.g., main, master, develop)
BASE_BRANCH="main"

# --- Ticket Tracker ---
# Currently supports Jira for polling. Other platforms (ClickUp, Linear) can
# use the /conductor command directly with a ticket URL.

# Jira project key (e.g., ECH, PROJ, MYAPP)
JIRA_PROJECT=""

# Label that triggers conductor pickup (must exist in your Jira project)
JIRA_LABEL="claude-conductor"

# Path to file containing Jira credentials (needs JIRA_BASE_URL, JIRA_EMAIL, JIRA_API_TOKEN)
# Defaults to $PROJECT_DIR/.env.local
# JIRA_CREDENTIALS_FILE="$PROJECT_DIR/.env.local"

# Statuses that mean "work has started", tried in order when a workflow offers no
# literal "In Progress". Issue types within one project can differ — a bug
# workflow may call this step "Analysis". Lowercase, pipe-separated.
# CONDUCTOR_START_WORK_STATUSES="in development|development|analysis|in analysis|design in progress|start progress|doing"

# In-progress-category statuses that do NOT mean work started, so the last-resort
# match never parks a ticket in one. Lowercase, pipe-separated.
# CONDUCTOR_NOT_START_STATUSES="blocked|qa|code review|review|on hold|waiting|insufficient info|ready to merge|awaiting ci|awaiting review|reopened"

# URL pattern for building ticket links. Use {{KEY}} as placeholder for the ticket key.
# This is what gets passed to /conductor as the URL.
# TICKET_URL_PATTERN="https://your-org.atlassian.net/browse/{{KEY}}"
# TICKET_URL_PATTERN="https://app.clickup.com/t/{{KEY}}"
# TICKET_URL_PATTERN="https://linear.app/your-org/issue/{{KEY}}"

# --- Claude ---
# Override Claude binary path (auto-detected from PATH if not set)
# CLAUDE_BIN="/path/to/claude"

# --- Tmux ---
# Path to tmux helper scripts (defaults to ~/.config/tmux/scripts)
# TMUX_SCRIPTS="$HOME/.config/tmux/scripts"

# --- Dev Server ---
# Command to start the dev server (run in the "server" tmux pane)
# The tmux pane has $SERVER_PORT set automatically by create-worktree-session.sh
# Leave empty to skip auto-starting the server
DEV_SERVER_CMD=""
# Examples:
#   DEV_SERVER_CMD="PORT=\$SERVER_PORT bun run dev"
#   DEV_SERVER_CMD="PORT=\$SERVER_PORT npm run dev"
#   DEV_SERVER_CMD="PORT=\$SERVER_PORT yarn dev"
#   DEV_SERVER_CMD="cargo run -- --port \$SERVER_PORT"

# --- Dependency Install ---
# Command to install dependencies in a new worktree (leave empty to skip)
INSTALL_CMD=""
# Examples:
#   INSTALL_CMD="bun install"
#   INSTALL_CMD="npm ci"
#   INSTALL_CMD="yarn install --frozen-lockfile"
#   INSTALL_CMD="cargo build"

# --- Limits ---
# Max worktrees per project — conductor won't pick new tickets beyond this
# MAX_WORKTREES=8

# --- Pull Requests ---
# GitHub username to assign PRs to (leave empty to skip assignment)
# PR_ASSIGNEE="your-github-username"

# Create the PR as a draft. "true" = open as draft and leave it draft;
# "false" (default) = open ready-for-review. When unset, conductor treats it
# as "false".
PR_DRAFT="false"

# Minimum seconds between re-dispatching the same /with-markers command to a
# single worktree. Guards against piling up keystrokes in a tmux pane that's
# still chewing through the previous command (e.g. /merge-base queued on top
# of an in-flight /merge-base). Per (worktree, command) — distinct commands
# aren't blocked by each other.
# CONDUCTOR_DISPATCH_COOLDOWN_SECS=300

# --- Worktree Setup Hook ---
# Optional script to run after worktree creation (e.g., copy env files, generate configs)
# Receives these environment variables: WORKTREE_PATH, PROJECT_DIR, WORKTREE_PORT, WORKTREE_NAME
# When unset, conductor uses conductor/hooks/<project>-setup.sh in the project's employer layer, if present.
# WORKTREE_SETUP_HOOK="$PROJECT_DIR/.conductor/setup-worktree.sh"
